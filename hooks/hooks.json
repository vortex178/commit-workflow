{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/on_prompt.py\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Monitor|CronCreate|ScheduleWakeup|RemoteTrigger|Skill|SendMessage|mcp__.*)$",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/gate.py\"" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^commit-workflow:commit-reviewer$",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/on_reviewer_stop.py\"" }
        ]
      }
    ]
  }
}
